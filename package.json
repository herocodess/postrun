{
  "name": "postrun-monorepo",
  "version": "0.0.0",
  "description": "Session review framework for AI coding agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "adapter:cc": "pnpm --silent --filter @postrun/core adapter:cc",
    "adapter:cline": "pnpm --silent --filter @postrun/core adapter:cline",
    "ingest": "pnpm --silent --filter @postrun/core ingest",
    "sessions": "pnpm --silent --filter @postrun/core sessions",
    "delete": "pnpm --silent --filter @postrun/core delete",
    "export": "pnpm --silent --filter @postrun/core export",
    "capture": "pnpm --silent --filter @postrun/core capture",
    "capture:cc:setup": "pnpm --silent --filter @postrun/core capture:cc:setup",
    "serve": "pnpm --filter @postrun/ui build && pnpm --filter @postrun/core serve",
    "dev:core": "pnpm --filter @postrun/core serve",
    "dev:ui": "pnpm --filter @postrun/ui dev",
    "dev:web": "pnpm --filter @postrun/web dev",
    "build:web": "pnpm --filter @postrun/web build",
    "demo:build": "node scripts/build-demo.mjs",
    "postrun": "pnpm --silent --filter @postrun/core postrun",
    "build:package": "pnpm --filter postrun build",
    "test:install": "pnpm --filter postrun test:install"
  },
  "keywords": [
    "postrun",
    "session-review",
    "ai-agents"
  ],
  "license": "MIT"
}
