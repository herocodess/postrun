# app.postrun.app settings.
#
# On your machine: copy this file to .env.local (git ignores it) and fill it in.
# On Vercel: add the same names under Project > Settings > Environment Variables.
# Never commit real values.

# Neon > your project > Connect > the pooled connection string (host has -pooler).
DATABASE_URL=

# A long random string: openssl rand -base64 32
# Use a different one on Vercel than on your machine.
BETTER_AUTH_SECRET=

# Where this app runs. On your machine: http://localhost:3001
# On Vercel: https://app.postrun.app
BETTER_AUTH_URL=http://localhost:3001

# GitHub > Settings > Developer settings > OAuth Apps.
# On your machine: the "Postrun (local)" app. On Vercel: the "Postrun" app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend > API Keys (sending access). Leave empty on your machine to print
# sign-in links in the terminal instead of emailing them.
RESEND_API_KEY=

# Optional. Who sign-in emails come from; the domain must be verified in Resend.
# EMAIL_FROM=Postrun <login@postrun.app>

# Who can open /admin (feedback) and gets an email for each piece of feedback.
# Comma separated, e.g. hm@heromomoh.com
ADMIN_EMAILS=
