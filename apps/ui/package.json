{
  "name": "@postrun/ui",
  "version": "0.0.0",
  "description": "Postrun UI: session timeline (Next.js, static export served by @postrun/core)",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port ${UI_PORT:-3000}",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@postrun/core": "workspace:*",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
