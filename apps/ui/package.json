{
  "name": "@postrun/ui",
  "version": "0.0.0",
  "description": "Postrun UI: session timeline (Next.js, static export served by @postrun/core)",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port ${UI_PORT:-3000}",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:demo": "NEXT_PUBLIC_POSTRUN_DEMO=1 next build"
  },
  "dependencies": {
    "@postrun/brand": "workspace:*",
    "geist": "^1.4.2",
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@postrun/core": "workspace:*",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.3.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
