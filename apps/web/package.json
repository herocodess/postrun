{
  "name": "@postrun/web",
  "version": "0.0.0",
  "description": "postrun.app marketing site (Next.js static export)",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port ${WEB_PORT:-3100}",
    "build": "next build && node scripts/prod-check.mjs",
    "check:prod": "node scripts/prod-check.mjs --strict",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@postrun/brand": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "geist": "^1.4.2",
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.3.3"
  }
}
